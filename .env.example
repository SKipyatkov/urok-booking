# Локальная разработка
DEBUG=True

# На продакшене: DEBUG=False и сгенерируйте случайный SECRET_KEY (50+ символов)
SECRET_KEY=change-me-in-production

DATABASE_URL=postgres://urok:urok@db:5432/urok_booking

# Локально: localhost,127.0.0.1
# На VPS: your-domain.ru,www.your-domain.ru
ALLOWED_HOSTS=localhost,127.0.0.1

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@urok-booking.local

