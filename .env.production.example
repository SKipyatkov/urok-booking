# Production environment — copy to .env on VPS and fill in real values

DEBUG=False
SECRET_KEY=generate-a-random-50-char-string-here

DATABASE_URL=postgres://urok:CHANGE_ME@db:5432/urok_booking
ALLOWED_HOSTS=your-domain.ru,www.your-domain.ru
CSRF_TRUSTED_ORIGINS=https://your-domain.ru,https://www.your-domain.ru

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@your-domain.ru

# ЮKassa (тестовый или боевой магазин)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://your-domain.ru/cabinet/billing/success/
